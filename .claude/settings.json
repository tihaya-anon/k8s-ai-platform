{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && \"${CLAUDE_PROJECT_DIR:-.}/hack/format.sh\" \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting edited file",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{ git diff --name-only --diff-filter=d HEAD; git ls-files --others --exclude-standard; } 2>/dev/null | grep -Ei '\\.(md|jsonc?|ya?ml|go)$' | sort -u | xargs -r \"${CLAUDE_PROJECT_DIR:-.}/hack/format.sh\" 2>/dev/null || true",
            "statusMessage": "Formatting changed files",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
