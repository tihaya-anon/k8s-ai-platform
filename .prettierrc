{
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    },
    {
      "files": ["*.yaml", "*.yml"],
      "options": {
        "proseWrap": "preserve",
        "singleQuote": false
      }
    }
  ],
  "plugins": ["prettier-plugin-sort-json"],
  "printWidth": 100,
  "proseWrap": "always",
  "tabWidth": 2
}
