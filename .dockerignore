# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# The agent image's entrypoint and the shell/editor configuration it bakes in. Everything is
# excluded by default above, so a COPY of an untracked path fails at build time rather than
# silently shipping nothing.
!hack/agent-entrypoint.sh
!hack/agent-home/**

# Upstream reference checkouts; not part of the build context.
deps/
