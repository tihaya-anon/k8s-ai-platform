{
  "name": "k8s-ai-platform",
  "image": "golang:1.25-bookworm",
  "features": {
    // The host's Docker, not a nested one: with --network=host a nested dockerd creates its bridges
    // and routes in the host's network namespace, and its kind network shadowed the host's.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "runArgs": ["--network=host"],
  "mounts": [
    "source=${localWorkspaceFolder}/hack/agent-home/.zshenv,target=/root/.zshenv,type=bind,readonly",
    "source=${localWorkspaceFolder}/hack/agent-home/.zprofile,target=/root/.zprofile,type=bind,readonly",
    "source=${localWorkspaceFolder}/hack/agent-home/.zshrc,target=/root/.zshrc,type=bind,readonly",
    "source=${localWorkspaceFolder}/hack/agent-home/.zsh_aliases,target=/root/.zsh_aliases,type=bind,readonly",
    "source=${localWorkspaceFolder}/hack/agent-home/.config/starship.toml,target=/root/.config/starship.toml,type=bind,readonly",
    // The cluster hack/set-up-cluster.sh made on the host; --network=host makes its 127.0.0.1 API
    // server reachable from here. Read-only so nothing in the container rewrites the host's contexts.
    "source=${localEnv:HOME}/.kube/config,target=/root/.kube/config,type=bind,readonly",
    // The Makefile links tools in LOCALBIN by absolute path, and the checkout's path differs here
    // from the host's, so a shared bin/ leaves dangling links on one side. Same fix as
    // hack/agent.sh: its own LOCALBIN on a volume. `docker volume rm` re-downloads the tools.
    "source=k8s-ai-devcontainer-tools,target=/root/.cache/k8s-ai-platform,type=volume"
  ],
  "containerEnv": {
    "LOCALBIN": "/root/.cache/k8s-ai-platform/bin"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh", "args": ["-l"] }
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint-v2",
        "go.lintOnSave": "package",
        // The Makefile's pinned golangci-lint, so the editor and `make lint` read .golangci.yml
        // with the same version.
        "go.alternateTools": {
          "golangci-lint-v2": "/root/.cache/k8s-ai-platform/bin/golangci-lint"
        },
        // Go Annotations reads its Kubebuilder marker definitions from controller-gen. It looks in
        // bin/ by default, but here LOCALBIN is elsewhere; this is the Makefile's pinned one.
        "goAnnotations.markers.controllerGenPath": "/root/.cache/k8s-ai-platform/bin/controller-gen",
        "gopls": {
          "ui.semanticTokens": true,
          // Same import grouping as the goimports settings in .golangci.yml and hack/format.sh.
          "formatting.local": "github.com/tihaya-anon/k8s-ai-platform"
        },
        // gofmt mandates tabs, so for Go this only sets how wide a tab renders.
        "[go]": {
          "editor.tabSize": 2,
          "editor.detectIndentation": false,
          "editor.defaultFormatter": "golang.go",
          "editor.formatOnSave": true,
          "editor.semanticHighlighting.enabled": true,
          "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
        },
        // hack/format.sh order: markdownlint fixes structure first, Prettier owns wrapping.
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": { "source.fixAll.markdownlint": "explicit" }
        },
        "[json][jsonc][yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[json][jsonc]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.detectIndentation": false
        }
      },
      "extensions": [
        "golang.go",
        "chihayaanon.go-annotations",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-containers",
        "ms-vscode.makefile-tools",
        "esbenp.prettier-vscode",
        "davidanson.vscode-markdownlint",
        "mermaidchart.vscode-mermaid-chart",
        "timonwong.shellcheck",
        "github.vscode-github-actions"
      ]
    }
  },
  "onCreateCommand": "bash .devcontainer/post-install.sh"
}
