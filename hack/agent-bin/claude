#!/usr/bin/env bash
# Launch Claude Code with its permission prompts bypassed.
#
# The container is the sandbox, so a second sandbox inside it buys nothing. --cap-drop ALL,
# --security-opt no-new-privileges, no Docker socket, no kubeconfig, and the only writable host
# path is this checkout: everything the agent could reach by approving a prompt, it could reach
# anyway, and every prompt is therefore a question whose answer is already fixed. Revoking the
# trust is `docker rm`, not an audit of what was approved.
#
# A flag, not `permissions.defaultMode` in settings.json: that file lives in the k8s-ai-claude
# volume, which outlives any one container, and a bypass written there would silently follow the
# credential into whatever mounts that volume next. The flag is scoped to the process.
set -euo pipefail

real=/usr/local/bin/claude

# The escape hatch for a session that wants the prompts back, and the loop guard: the wrapper
# shadows the real binary by PATH, so an unguarded re-exec would find itself.
if [[ ${AGENT_BYPASS:-1} != 1 ]]; then
  exec "$real" "$@"
fi

# Subcommands take their own option sets and reject the flag outright; only the default command --
# interactive, or -p -- accepts it.
case ${1:-} in
config | mcp | migrate-installer | doctor | update | install | setup-token | plugin)
  exec "$real" "$@"
  ;;
esac

# Already asked for explicitly, or asked for the opposite. Passing it twice is harmless, but
# `--permission-mode plan` followed by an injected bypass is not what the caller typed.
for arg in "$@"; do
  case $arg in
  --dangerously-skip-permissions | --permission-mode | --permission-mode=*)
    exec "$real" "$@"
    ;;
  esac
done

exec "$real" --dangerously-skip-permissions "$@"
