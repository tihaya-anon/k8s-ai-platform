#!/usr/bin/env bash
# Format the staged files, restage them, then gate the commit on markdownlint.
#
# Formatting is silent and automatic; linting is a gate. The split matters because
# a formatter can fix whitespace but cannot decide whether a heading skips a level
# or a code fence forgot its language — those need a human, so they block.
#
# Enabled by `git config core.hooksPath hack/git-hooks`. To bypass once:
# `git commit --no-verify`. To disable entirely: `git config --unset core.hooksPath`.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Claude reads a generated worktree copy, never a second tracked source of truth.
# Run after formatting, even on early exits or lint failures; never stage the copy.
trap 'cp -- "$repo_root/AGENTS.md" "$repo_root/CLAUDE.md" || exit 1' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

# Only files staged as added/copied/modified/renamed; a deleted path has nothing
# left to format, and formatting it would resurrect it into the index.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[[ ${#staged[@]} -eq 0 ]] && exit 0

targets=()
for f in "${staged[@]}"; do
  case $f in
  *.md | *.json | *.jsonc | *.yaml | *.yml | *.go) targets+=("$f") ;;
  esac
done
[[ ${#targets[@]} -eq 0 ]] && exit 0

# Partially staged files would have their unstaged hunks swept into the commit if
# we reformatted the worktree copy and blindly restaged it. Warn and leave them.
partial=()
for f in "${targets[@]}"; do
  if ! git diff --quiet -- "$f"; then partial+=("$f"); fi
done

./hack/format.sh "${targets[@]}"

for f in "${targets[@]}"; do
  skip=0
  for p in ${partial[@]+"${partial[@]}"}; do [[ $p == "$f" ]] && skip=1; done
  [[ $skip -eq 1 ]] || git add -- "$f"
done

if [[ ${#partial[@]} -gt 0 ]]; then
  printf 'pre-commit: formatted but NOT restaged (unstaged changes present):\n'
  printf '  %s\n' "${partial[@]}"
fi

md=()
for f in "${targets[@]}"; do [[ $f == *.md ]] && md+=("$f"); done

rc=0
if [[ ${#md[@]} -gt 0 ]]; then
  if have markdownlint-cli2; then
    markdownlint-cli2 "${md[@]}" || rc=1
  else
    printf 'pre-commit: markdownlint-cli2 not installed; skipping the markdown gate.\n'
    printf '            npm install -g markdownlint-cli2\n'
  fi
fi

go=()
for f in "${targets[@]}"; do [[ $f == *.go ]] && go+=("$f"); done
if [[ ${#go[@]} -gt 0 ]] && have gofmt; then
  unformatted="$(gofmt -l "${go[@]}")"
  if [[ -n $unformatted ]]; then
    printf 'pre-commit: gofmt could not normalise:\n%s\n' "$unformatted"
    rc=1
  fi
fi

[[ $rc -ne 0 ]] && printf '\npre-commit: fix the above, or commit with --no-verify.\n'
exit $rc
