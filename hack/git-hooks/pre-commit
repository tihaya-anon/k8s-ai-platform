#!/usr/bin/env bash
# Format the staged files, restage them, then gate the commit on markdownlint.
#
# Formatting is silent and automatic; linting is a gate. The split matters because
# a formatter can fix whitespace but cannot decide whether a heading skips a level
# or a code fence forgot its language — those need a human, so they block.
#
# Enabled by `git config core.hooksPath hack/git-hooks`. To bypass once:
# `git commit --no-verify`. To disable entirely: `git config --unset core.hooksPath`.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

# Claude reads a generated worktree copy, never a second tracked source of truth.
# Run after formatting, even on early exits or lint failures; never stage the copy.
trap 'cp -- "$repo_root/AGENTS.md" "$repo_root/CLAUDE.md" || exit 1' EXIT

have() { command -v "$1" >/dev/null 2>&1; }

# Only files staged as added/copied/modified/renamed; a deleted path has nothing
# left to format, and formatting it would resurrect it into the index.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[[ ${#staged[@]} -eq 0 ]] && exit 0

# Everything staged goes to format.sh, which decides what it can format -- the same reason that
# script no longer keeps an extension list of its own. This one had the matching list and the
# matching gap: .ts and .prettierrc reached neither. A file the formatters leave alone is restaged
# unchanged, which `git add` treats as a no-op.
targets=("${staged[@]}")

# Shell scripts need a second pass, because shellcheck is a gate and not a formatter: it has no
# --fix, so it reports rather than rewrites and its findings have to stop the commit. Detected by
# shebang as well as by extension, because hack/git-hooks/* and hack/agent-bin/* carry no .sh
# suffix. The pattern does not match zsh -- there is no word boundary before the `sh` in
# `zsh` -- and that is deliberate: shellcheck has no zsh mode at all and reports zsh's own glob
# qualifiers as syntax errors.
shell=()
for f in "${staged[@]}"; do
  case $f in
  *.sh) shell+=("$f") ;;
  *)
    if head -n1 -- "$f" 2>/dev/null |
      grep -qE '^#!.*(/|[[:space:]])(ba)?sh([[:space:]]|$)'; then
      shell+=("$f")
    fi
    ;;
  esac
done

# Partially staged files would have their unstaged hunks swept into the commit if
# we reformatted the worktree copy and blindly restaged it. Warn and leave them.
partial=()
for f in "${targets[@]}"; do
  if ! git diff --quiet -- "$f"; then partial+=("$f"); fi
done

# A non-zero status here is not "a file changed", it is "a formatter could not do its job" --
# Prettier failing to parse a file, or the plugin tree being absent. Letting that through is what
# allowed a kustomization.yaml that is not valid YAML into a commit: the errors were printed and
# the commit proceeded. Formatting stays silent when it succeeds; failing to format is a gate.
rc=0
./hack/format.sh "${targets[@]}" || rc=1

for f in "${targets[@]}"; do
  skip=0
  for p in ${partial[@]+"${partial[@]}"}; do [[ $p == "$f" ]] && skip=1; done
  [[ $skip -eq 1 ]] || git add -- "$f"
done

if [[ ${#partial[@]} -gt 0 ]]; then
  printf 'pre-commit: formatted but NOT restaged (unstaged changes present):\n'
  printf '  %s\n' "${partial[@]}"
fi

md=()
for f in "${targets[@]}"; do [[ $f == *.md ]] && md+=("$f"); done

if [[ ${#md[@]} -gt 0 ]]; then
  if have markdownlint-cli2; then
    markdownlint-cli2 "${md[@]}" || rc=1
  else
    printf 'pre-commit: markdownlint-cli2 not installed; skipping the markdown gate.\n'
    printf '            npm install -g markdownlint-cli2\n'
  fi
fi

if [[ ${#shell[@]} -gt 0 ]]; then
  if have shellcheck; then
    # -x, so a script that sources hack/lib/registry.sh is checked against the real file instead
    # of being reported as an unfollowed source. Same invocation the VS Code extension makes.
    shellcheck -x -- "${shell[@]}" || rc=1
  else
    printf 'pre-commit: shellcheck not installed; skipping the shell gate.\n'
    printf '            it is in both container images; on the host, apt install shellcheck\n'
  fi
fi

go=()
for f in "${targets[@]}"; do [[ $f == *.go ]] && go+=("$f"); done
if [[ ${#go[@]} -gt 0 ]] && have gofmt; then
  unformatted="$(gofmt -l "${go[@]}")"
  if [[ -n $unformatted ]]; then
    printf 'pre-commit: gofmt could not normalise:\n%s\n' "$unformatted"
    rc=1
  fi
fi

[[ $rc -ne 0 ]] && printf '\npre-commit: fix the above, or commit with --no-verify.\n'
exit $rc
