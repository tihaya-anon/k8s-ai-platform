{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",

  "MD004": { "style": "dash" },
  "MD010": { "code_blocks": false },
  "MD010_comment": "Go code is tab-indented; converting tabs to spaces inside a fence makes copied code non-gofmt.",
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD029": { "style": "one_or_ordered" },
  "MD033": { "allowed_elements": ["br", "details", "summary", "img", "kbd"] },
  "MD035": { "style": "---" },
  "MD036": false,
  "MD044": {
    "names": [
      "Kubernetes",
      "Kueue",
      "KServe",
      "CNCF",
      "Prometheus",
      "Grafana",
      "GitHub",
      "YAML",
      "JSON",
      "CRD",
      "RBAC",
      "PVC",
      "GPU"
    ],
    "code_blocks": false,
    "html_elements": false
  },
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" },
  "default": true
}
