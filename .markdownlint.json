{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",

  "default": true,

  "MD013": false,

  "_comment_md010": "Go code is tab-indented; converting tabs to spaces inside a fence makes copied code non-gofmt.",
  "MD010": { "code_blocks": false },
  "MD036": false,

  "MD024": { "siblings_only": true },
  "MD029": { "style": "one_or_ordered" },
  "MD033": { "allowed_elements": ["br", "details", "summary", "img", "kbd"] },

  "MD004": { "style": "dash" },
  "MD035": { "style": "---" },
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" },

  "MD044": {
    "names": [
      "Kubernetes",
      "Kueue",
      "KServe",
      "CNCF",
      "Prometheus",
      "Grafana",
      "GitHub",
      "YAML",
      "JSON",
      "CRD",
      "RBAC",
      "PVC",
      "GPU"
    ],
    "code_blocks": false,
    "html_elements": false
  }
}
