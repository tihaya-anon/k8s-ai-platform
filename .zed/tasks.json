[
  {
    "label": "make fmt vet test",
    "command": "make",
    "args": ["fmt", "vet", "test"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "tags": ["gate"]
  },
  {
    "label": "make manifests generate",
    "command": "make",
    "args": ["manifests", "generate"],
    "use_new_terminal": false
  },
  {
    "label": "make lint",
    "command": "make",
    "args": ["lint"],
    "use_new_terminal": false
  },
  {
    "label": "format this file",
    "command": "hack/format.sh",
    "args": ["$ZED_RELATIVE_FILE"],
    "use_new_terminal": false,
    "reveal": "no_focus"
  },
  {
    "label": "go test this package",
    "command": "go",
    "args": ["test", "./..."],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false
  },
  {
    "label": "set up the kind cluster",
    "command": "hack/set-up-cluster.sh",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "agent container shell",
    "command": "hack/agent.sh",
    "args": ["shell"],
    "use_new_terminal": true
  }
]
