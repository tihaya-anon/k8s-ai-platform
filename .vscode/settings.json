{
  // The Makefile's pinned, plugin-built golangci-lint -- the linter the Go extension runs on save,
  // so that the editor and `make lint` agree on version, plugins and .golangci.yml.
  //
  // Both this and goAnnotations.markers.controllerGenPath below take a literal path in which VS
  // Code expands only ${workspaceFolder}, so bin/ has to mean the same thing in a host window and
  // in a devcontainer window. It does: the devcontainer mounts its tools volume over this very
  // directory rather than relocating LOCALBIN, which is what lets one literal be correct in both.
  // See that entry in .devcontainer/devcontainer.json's "mounts".
  //
  // It must be the binary, not a wrapper script. The Go extension runs `go version -m` on whatever
  // this names to decide whether the tool is stale; on a shell script that fails, and vscode-go
  // reads "no version" as "recompile it", so every window start offered to rebuild a tool that was
  // already current. go.toolsManagement.checkForUpdates does not gate that check.
  //
  // The cost of naming a binary is that nothing builds it on demand -- a fresh clone needs one
  // `make golangci-lint` before the editor lints, which .devcontainer/post-install.sh runs here.
  "go.alternateTools": {
    "golangci-lint-v2": "${workspaceFolder}/bin/golangci-lint"
  },
  // Go's own build and vet diagnostics arrive from gopls as you type, so the extension's
  // save-time passes would only duplicate them a second later. Lint is the exception: it runs
  // linters gopls does not have.
  "go.buildOnSave": "off",
  // Lint the saved file's package on save. This is the only scope fast enough to run every time:
  // warm, one package is about a second, and the whole module is about twenty at several hundred
  // percent CPU.
  //
  // The cost is worth remembering: the editor only ever reports in packages you have saved a file
  // in, so a finding in internal/webhook stays invisible while you work in internal/controller.
  // `make lint` over ./... remains the gate.
  "go.lintOnSave": "package",
  // Unset -- the extension's default -- means no linter runs at all and the Problems panel shows
  // only what gopls found, which is how a tree that `make lint` rejects can look clean in the
  // editor. gopls stays a separate, additional source of diagnostics; this does not replace it.
  //
  // Every setting here is in this tracked file rather than in .devcontainer/devcontainer.json,
  // because that file's settings reach exactly one environment: a window attached to the
  // devcontainer. The same checkout opened over WSL, over SSH or on the host got none of them.
  // Workspace settings reach every window and outrank the machine-scope settings a devcontainer
  // contributes, so they are the one owner for anything that must agree with a `make` target.
  // Keys here are sorted by Prettier, so each comment names its own key and never a neighbour.
  "go.lintTool": "golangci-lint-v2",
  "go.vetOnSave": "off",
  // Where the Go Annotations extension reads its Kubebuilder marker definitions, so a wrong path
  // means marker hover and completion quietly describe a different controller-gen than `make
  // manifests` runs. Same path reasoning as go.alternateTools above; this extension keeps its tool
  // path in its own namespace rather than in Go's.
  "goAnnotations.markers.controllerGenPath": "${workspaceFolder}/bin/controller-gen"
}
